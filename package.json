{
  "name": "dsh-selection-companion",
  "version": "0.1.0",
  "description": "Windows selection context bridge for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:selection": "vitest run tests/selection-context.spec.ts",
    "demo:selection": "pnpm build && node scripts/demo-selection.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:bundle",
    "prepare": "pnpm build",
    "prepack": "pnpm check"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "selection",
    "context",
    "windows"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mivaille777/Harness-plugins.git"
  },
  "homepage": "https://github.com/mivaille777/Harness-plugins#readme",
  "bugs": {
    "url": "https://github.com/mivaille777/Harness-plugins/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
