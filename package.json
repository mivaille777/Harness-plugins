{
  "name": "dsh-selection-companion",
  "version": "0.1.0",
  "description": "Windows selection context bridge for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/bridge/index.d.ts",
      "default": "./lib/bridge/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./context": {
      "types": "./lib/context/plugin.d.ts",
      "default": "./lib/context/plugin.js"
    },
    "./session": {
      "types": "./lib/session/plugin.d.ts",
      "default": "./lib/session/plugin.js"
    },
    "./bridge": {
      "types": "./lib/bridge/plugin.d.ts",
      "default": "./lib/bridge/plugin.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:ec01": "pnpm typecheck && pnpm test && pnpm test:native-ui && pnpm test:lens:session",
    "check:ec02": "pnpm typecheck && pnpm test:protocol && pnpm exec vitest run tests/ec01-expanded-context.spec.ts tests/ec01-session-material.spec.ts tests/ec02-material-schema.spec.ts && pnpm --dir native build && pnpm test:rust",
    "check:ec03": "pnpm check:ec02 && pnpm --dir native exec vitest run src/contextAuthorization.test.ts src/ec03-context-authorization.test.tsx src/App.test.tsx",
    "check:ec04": "pnpm check:ec03 && pnpm --dir native exec vitest run src/requestMaterial.test.ts src/ec04-model-input.test.tsx src/App.test.tsx",
    "check:ec05": "pnpm check:ec04 && pnpm --dir native exec vitest run src/api/bridge.test.ts src/ec05-durable-material.test.tsx src/App.test.tsx && pnpm test:rust",
    "check:ec06": "pnpm check:ec05 && pnpm exec vitest run tests/ec06-authorized-context-tools.spec.ts tests/session-tools.spec.ts",
    "check:ec07": "pnpm check:ec06 && pnpm exec vitest run tests/ec07-session-restart.spec.ts && pnpm test:ec07:model-boundary:unit",
    "check:ec08": "pnpm check:ec07 && pnpm test:ec08:session-model-boundary:unit",
    "check:ec09": "pnpm check:ec08 && pnpm test:ec09:driver-contract",
    "test:ec07:model-boundary:unit": "node scripts/test-ec07-model-boundary.mjs",
    "test:ec07:model-boundary": "node scripts/ec07-model-boundary.mjs",
    "test:ec08:session-model-boundary:unit": "node --test scripts/test-ec08-session-model-boundary.mjs",
    "test:ec08:session-model-boundary": "node scripts/ec08-session-model-boundary.mjs",
    "test:ec09:driver-contract": "node --test scripts/test-lens-runner.mjs",
    "test:ec09:browser-native-pipe": "node browser-extension/scripts/ec09-browser-native-pipe.mjs",
    "test:ec09:tauri-lens": "node browser-extension/scripts/ec09-tauri-lens-webview2.mjs",
    "test:selection": "vitest run tests/selection-context.spec.ts",
    "test:context-expansion": "vitest run tests/selection-context.spec.ts",
    "test:protocol": "vitest run tests/protocol.spec.ts",
    "test:contract": "pnpm test:protocol && pnpm --dir native build && pnpm test:rust",
    "test:bridge": "vitest run tests/bridge-server.spec.ts",
    "test:bridge:integration": "node scripts/test-bridge-integration.mjs",
    "test:rust": "cargo test --manifest-path native/src-tauri/Cargo.toml",
    "test:capture": "cargo test --manifest-path native/src-tauri/Cargo.toml capture::tests",
    "test:capture:windows": "node scripts/test-capture-windows.mjs",
    "test:native-ui": "pnpm --dir native test",
    "test:lens": "pnpm --dir native test",
    "test:lens:session": "pnpm --dir native exec vitest run src/sessionProjection.test.ts src/App.test.tsx src/api/bridge.test.ts",
    "test:lens:e2e": "node scripts/test-lens-e2e.mjs",
    "test:lens:runner": "node scripts/test-lens-runner.mjs",
    "test:ui:a11y": "pnpm --dir native exec vitest run src/App.test.tsx -t \"primary Lens controls labelled\"",
    "test:ui:visual": "node scripts/test-ui-visual.mjs",
    "test:perf": "pnpm build && node --test scripts/perf.test.mjs && node scripts/test-perf.mjs",
    "test:human-factors:fixtures": "node --test scripts/human-factors.test.mjs && node scripts/test-human-factors-fixtures.mjs",
    "report:human-factors": "node scripts/report-human-factors.mjs",
    "test:installer": "node --test scripts/installer.test.mjs && node scripts/test-installer.mjs",
    "test:installer:smoke": "node scripts/test-installer-smoke.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:r07:runner": "node scripts/test-r07-runner.mjs",
    "test:session": "vitest run tests/session-service.spec.ts tests/bridge-server.spec.ts",
    "test:session:history": "vitest run tests/session-history.spec.ts tests/session-service.spec.ts tests/session-transport.spec.ts",
    "test:session:transport": "vitest run tests/session-transport.spec.ts",
    "test:session:replay": "vitest run tests/session-replay.spec.ts",
    "test:session:tools": "vitest run tests/session-tools.spec.ts",
    "test:session:e2e": "node scripts/test-session-e2e.mjs",
    "test:browser-accessibility": "cargo test --manifest-path native/src-tauri/Cargo.toml browser_accessibility",
    "test:browser-extension": "pnpm --dir browser-extension test",
    "test:browser-extension:e2e": "pnpm --dir browser-extension test:e2e",
    "test:browser": "pnpm test:browser-extension",
    "test:browser:e2e": "pnpm test:browser-extension:e2e",
    "check:task3": "pnpm check && pnpm --dir native build && pnpm test:rust",
    "check:task4": "pnpm check && pnpm --dir native build && pnpm test:rust && pnpm test:native-ui && cargo check --manifest-path native/src-tauri/Cargo.toml",
    "check:task5": "pnpm check:task4 && pnpm test:browser-accessibility",
    "check:browser-extension": "pnpm --dir browser-extension check && pnpm native:host:build",
    "check:browser-extension:e2e": "pnpm check:browser-extension && pnpm test:browser-extension:e2e",
    "browser:build": "pnpm --dir browser-extension build",
    "native:dev": "pnpm --dir native tauri:dev",
    "native:build": "pnpm --dir native tauri:build",
    "native:host:build": "cargo build --manifest-path native/src-tauri/Cargo.toml --bin dsh-selection-companion-host",
    "native:host:register": "powershell -ExecutionPolicy Bypass -File scripts/register-native-host.ps1",
    "native:host:unregister": "powershell -ExecutionPolicy Bypass -File scripts/unregister-native-host.ps1",
    "debug:selection": "pnpm build && node scripts/debug-selection.mjs",
    "demo:selection": "pnpm build && node scripts/demo-selection.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:bundle",
    "prepare": "pnpm build",
    "prepack": "pnpm check"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "selection",
    "context",
    "windows"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mivaille777/Harness-plugins.git"
  },
  "homepage": "https://github.com/mivaille777/Harness-plugins#readme",
  "bugs": {
    "url": "https://github.com/mivaille777/Harness-plugins/issues"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
